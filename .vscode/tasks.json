{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build-debug",
			"type": "shell",
			"command": "mingw32-make BUILD=debug",
			"group": { "kind": "build", "isDefault": true }
		},
		{
			"label": "clean-build-debug",
			"type": "shell",
			"command": "mingw32-make BUILD=debug clean build"
		},
        {
            "label": "update-clean-build-debug",
            "type": "shell",
            "command": "mingw32-make BUILD=debug update clean build"
        },
		{
			"label": "run-release",
			"type": "shell",
			"command": "mingw32-make update clean build && build/main.exe"
		}
	]
}